# Copy to .env and fill in real values. Never commit the real .env file.

# --- Telegram ---
BOT_TOKEN=
ALLOWED_CHAT_ID=

# --- Proxmox (API token, created for the dedicated telegram-bot@pve user) ---
PROXMOX_URL=https://proxmox.example.lan:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=telegram-bot@pve!bot
PROXMOX_TOKEN_SECRET=

# --- Portainer ---
PORTAINER_URL=https://portainer.example.lan:9443
PORTAINER_API_TOKEN=

# Comma-separated "endpoint_id:label" pairs, one per Docker host Portainer manages.
PORTAINER_ENDPOINTS=3:VM101,4:VM103

# Proxmox and Portainer both use self-signed certs on the LAN.
VERIFY_TLS=false

LOG_LEVEL=INFO
