# Copy to .env and fill in real values. Never commit the real .env file.

# --- Telegram ---
BOT_TOKEN=
ALLOWED_CHAT_ID=

# --- Proxmox (API token, created for the dedicated telegram-bot@pve user) ---
PROXMOX_URL=https://192.168.178.10:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=telegram-bot@pve!bot
PROXMOX_TOKEN_SECRET=

# --- Portainer ---
PORTAINER_URL=https://192.168.178.17:9443
PORTAINER_API_TOKEN=
PORTAINER_ENDPOINT_ID=3

# Proxmox and Portainer both use self-signed certs on the LAN.
VERIFY_TLS=false

# Optional: DEBUG for verbose logging
LOG_LEVEL=INFO
